# متغيرات البيئة للمشروع الرئيسي — انسخ هذا الملف إلى .env.local وضع القيم الحقيقية
# (نفس القيم تُوضع في Vercel → Settings → Environment Variables)

# إلزاميان
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# رابط خدمة الدمج بعد نشرها على Vercel (مشروع Root Directory = merger)
MERGER_API_BASE=

# اختياري
# MCP_ACCESS_TOKEN=          # إن ضُبط يُطلب Bearer token على /mcp
# KIE_IMAGE_MODEL=           # تجاوز أسماء الموديلات إن لزم
# KIE_VIDEO_MODEL=
# COMETAPI_IMAGE_MODEL=
# COMETAPI_VIDEO_MODEL=
