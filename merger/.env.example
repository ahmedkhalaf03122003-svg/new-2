# خدمة الدمج — متغيرات البيئة
# انسخ هذا الملف إلى .env وضع القيم الحقيقية (لا تُرفع .env إلى Git)

# إلزاميان
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# اختياريان — الحدود القابلة للضبط
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium

# بورْت خادم التطوير المحلي
PORT=3001
